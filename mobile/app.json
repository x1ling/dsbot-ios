{
  "expo": {
    "name": "DS Bot Lab",
    "slug": "dsbot-lab",
    "web": {
      "bundler": "metro",
      "output": "single",
      "name": "DS Bot",
      "shortName": "DS Bot",
      "themeColor": "#fcfcfc",
      "favicon": "./assets/icon.png"
    },
    "experiments": {
      "baseUrl": "/web"
    },
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.x1ling.dsbot.lab",
      "infoPlist": {
        "CFBundleLocalizations": [
          "en",
          "zh-Hans"
        ],
        "ITSAppUsesNonExemptEncryption": false,
        "NSSupportsLiveActivities": true,
        "NSSupportsLiveActivitiesFrequentUpdates": true
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#eef1f7",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.x1ling.dsbot.lab",
      "permissions": [
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "scheme": "dsbotlab",
    "plugins": [
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "DS Bot uses the camera to scan the pairing code that your computer shows.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      "./plugins/android-release-signing.js",
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "extraProguardRules": "-keep class com.google.mlkit.** { *; }\n-keep class com.google.android.gms.internal.mlkit_vision_barcode.** { *; }\n-keep class com.google.android.gms.internal.mlkit_vision_common.** { *; }\n-keep class com.google.android.odml.** { *; }"
          }
        }
      ],
      "expo-live-activity",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#0EA5A4",
          "defaultChannel": "default"
        }
      ]
    ],
    "version": "0.4.0"
  }
}